# ------------------------------------------------------------
# Probe trials only: within each noise level, fit ONE logistic
# model with BOTH stimN and stimSlope, then compare predictors
# (standardized coefficients + Ferrigno-style z test).
# ------------------------------------------------------------
library(dplyr)
# 1) Load data
df <- read.csv("/mnt/data/Thesis2_PilotData_Colin.csv")
# ------------------------------------------------------------
# Probe trials only: within each noise level, fit ONE logistic
# model with BOTH stimN and stimSlope, then compare predictors
# (standardized coefficients + Ferrigno-style z test).
# ------------------------------------------------------------
library(dplyr)
# 1) Load data
df <- read.csv("/mnt/data/Thesis2_PilotData_Colin.csv")
head(Thesis2_PilotData_Colin)
library(dplyr)
# assume df is already loaded
# df <- Thesis2_PilotData_Colin
# Probe trials only + binary DV
df_probe <- df %>%
filter(trialType == "probe", isProbe == TRUE) %>%
mutate(
responseKey_bin = ifelse(responseKey == "A", 1, 0)
)
# Fit and print models by noise level
for (nz in sort(unique(df_probe$noise))) {
cat("\n==============================\n")
cat("Noise level:", nz, "\n")
cat("==============================\n")
m <- glm(
responseKey_bin ~ stimN + stimSlope,
family = binomial(link = "logit"),
data = df_probe %>% filter(noise == nz)
)
print(summary(m))
}
