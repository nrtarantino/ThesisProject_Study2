ThesisStudy2PilotData_NickT <- read.csv("~/Downloads/ThesisStudy2PilotData_NickT.csv")
View(ThesisStudy2PilotData_NickT)
# Predict responseKey from stimN + stimSlope on probe trials only
library(tidyverse)
df <-ThesisStudy2PilotData_NickT %>%
filter(isProbe == TRUE) %>%
mutate(
# make sure responseKey is a 2-level factor in a stable order
responseKey = factor(responseKey),
responseKey = fct_drop(responseKey)
)
# --- Option A: Simple logistic regression (no random effects) ---
m_glm <- glm(responseKey ~ stimN + stimSlope, data = df, family = binomial())
summary(m_glm)
# Predicted probability of the second factor level (check levels(df$responseKey))
df_pred <- df %>%
mutate(
p_resp2 = predict(m_glm, newdata = ., type = "response"),
predKey = if_else(p_resp2 >= 0.5, levels(responseKey)[2], levels(responseKey)[1])
)
# Confusion matrix
table(actual = df_pred$responseKey, predicted = df_pred$predKey)
# --- Option B (often better): Mixed-effects logistic regression with participant random intercept ---
# install.packages("lme4")
library(lme4)
m_glmer <- glmer(responseKey ~ stimN + stimSlope + (1 | participantId),
data = df, family = binomial())
library(tidyverse)
df <- ThesisStudy2PilotData_NickT %>%
filter(isProbe == TRUE) %>%
mutate(
responseKey = factor(responseKey),
responseKey = fct_drop(responseKey)
)
# Check levels (important for interpretation)
levels(df$responseKey)
# Fit logistic regression
m <- glm(responseKey ~ stimN + stimSlope,
data = df,
family = binomial())
summary(m)
# Add predicted probabilities
df_pred <- df %>%
mutate(
prob_second_level = predict(m, type = "response"),
predKey = if_else(
prob_second_level >= 0.5,
levels(responseKey)[2],
levels(responseKey)[1]
)
)
# Confusion matrix
table(actual = df_pred$responseKey,
predicted = df_pred$predKey)
library(dplyr)
df_probe <- df %>%
filter(isProbe == TRUE) %>%
mutate(
responseKey = factor(responseKey),
responseKey = droplevels(responseKey),
noise = factor(noise)
)
df_pred <- df_probe %>%
group_by(noise) %>%
group_modify(~ {
m <- glm(responseKey ~ stimN + stimSlope,
data = .x,
family = binomial())
.x %>%
mutate(
prob = predict(m, type = "response"),
predKey = ifelse(
prob >= 0.5,
levels(responseKey)[2],
levels(responseKey)[1]
)
)
}) %>%
ungroup()
m_full <- glm(responseKey ~ stimN * noise + stimSlope * noise,
data = df_probe,
family = binomial())
summary(m_full)
