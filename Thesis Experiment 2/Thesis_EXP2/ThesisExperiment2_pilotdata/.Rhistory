# Make sure responseKey is binary: A = 1, L = 0
df$responseKey_bin <- ifelse(df$responseKey == "A", 1, 0)
# (Optional but recommended) center predictors
df$stimN_c     <- df$stimN - mean(df$stimN, na.rm = TRUE)
df$stimSlope_c <- df$stimSlope - mean(df$stimSlope, na.rm = TRUE)
# Fit competing models
mN     <- glm(responseKey_bin ~ stimN_c,              data = df, family = binomial)
mSlope <- glm(responseKey_bin ~ stimSlope_c,          data = df, family = binomial)
mBoth  <- glm(responseKey_bin ~ stimN_c + stimSlope_c, data = df, family = binomial)
# Compare which single predictor is better (lower AIC = better)
aics <- AIC(mN, mSlope, mBoth)
print(aics)
best_single <- rownames(aics)[which.min(aics$AIC[aics$df == 2])]  # df==2 isolates single-predictor models
cat("\nBest single predictor by AIC:", best_single, "\n")
# Does the other predictor add value beyond the best one?
if (best_single == "mN") {
cat("\nDoes adding stimSlope improve over stimN?\n")
print(anova(mN, mBoth, test = "Chisq"))
} else {
cat("\nDoes adding stimN improve over stimSlope?\n")
print(anova(mSlope, mBoth, test = "Chisq"))
}
# Ensure binary DV
df$responseKey_bin <- ifelse(df$responseKey == "A", 1, 0)
# Center predictors globally (important for comparability)
df$stimN_c     <- df$stimN - mean(df$stimN, na.rm = TRUE)
df$stimSlope_c <- df$stimSlope - mean(df$stimSlope, na.rm = TRUE)
# Loop over noise levels
for (n in sort(unique(df$noise))) {
cat("\n==============================\n")
cat("Noise level:", n, "\n")
cat("==============================\n")
dfn <- subset(df, noise == n)
# Fit models
mN     <- glm(responseKey_bin ~ stimN_c,              data = dfn, family = binomial)
mSlope <- glm(responseKey_bin ~ stimSlope_c,          data = dfn, family = binomial)
mBoth  <- glm(responseKey_bin ~ stimN_c + stimSlope_c, data = dfn, family = binomial)
# AIC comparison
aics <- AIC(mN, mSlope, mBoth)
print(aics)
# Identify best single predictor
single_models <- aics[aics$df == 2, ]
best_single <- rownames(single_models)[which.min(single_models$AIC)]
cat("\nBest single predictor by AIC:", best_single, "\n")
# Likelihood-ratio test: does the other predictor add value?
if (best_single == "mN") {
cat("\nDoes adding stimSlope improve over stimN?\n")
print(anova(mN, mBoth, test = "Chisq"))
} else {
cat("\nDoes adding stimN improve over stimSlope?\n")
print(anova(mSlope, mBoth, test = "Chisq"))
}
}
for (n in sort(unique(df$noise))) {
cat("\n==============================\n")
cat("Noise level:", n, "\n")
cat("==============================\n")
dfn <- subset(df, noise == n & isProbe == TRUE)
# Optional: guard against empty cells
if (nrow(dfn) < 20) {
cat("Too few probe trials — skipping\n")
next
}
mN     <- glm(responseKey_bin ~ stimN_c,               data = dfn, family = binomial)
mSlope <- glm(responseKey_bin ~ stimSlope_c,           data = dfn, family = binomial)
mBoth  <- glm(responseKey_bin ~ stimN_c + stimSlope_c, data = dfn, family = binomial)
aics <- AIC(mN, mSlope, mBoth)
print(aics)
single_models <- aics[aics$df == 2, ]
best_single <- rownames(single_models)[which.min(single_models$AIC)]
cat("\nBest single predictor by AIC:", best_single, "\n")
if (best_single == "mN") {
cat("\nDoes adding stimSlope improve over stimN?\n")
print(anova(mN, mBoth, test = "Chisq"))
} else {
cat("\nDoes adding stimN improve over stimSlope?\n")
print(anova(mSlope, mBoth, test = "Chisq"))
}
}
