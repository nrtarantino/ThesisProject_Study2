library(dplyr)
rt_means <- forced_choice_data_1766445683857 %>%
filter(!is.na(reactionTime), !is.na(diffN)) %>%
group_by(bigBlock, diffN) %>%
summarise(
mean_RT = mean(reactionTime),
n_trials = n(),
.groups = "drop"
)
library(ggplot2)
ggplot(rt_means, aes(x = diffN, y = mean_RT)) +
geom_point() +
geom_line() +
facet_wrap(~ bigBlock) +
labs(
x = "Numerical Difference (diffN)",
y = "Mean Reaction Time (ms)",
title = "Mean Reaction Time by diffN for Each Big Block"
) +
theme_minimal()
